<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
     <link rel="stylesheet" href="editor.css">
    <title>CodeCollab - Editor</title>

    
</head>

<body>

    <!-- Navbar -->

    <nav class="navbar">

        <div class="logo">
            CodeCollab
        </div>

        <div class="editor-title">
            Collaborative Editor
        </div>

        <a href="/project" class="back-btn">
            ← Projects
        </a>

    </nav>


    <!-- Main -->

    <main class="container">

        <div class="header">

            <div>
                <h1>
                    Code Editor
                </h1>

                <p>
                    Write and collaborate on code in real time.
                </p>
            </div>


            <div class="active-users">

                <span class="active-title">
                    Active:
                </span>

                <div id="users"></div>

            </div>

        </div>


        <!-- Monaco Editor -->

        <div class="editor-wrapper">

            <div id="editor"></div>

        </div>


        <!-- Bottom -->

        <div class="bottom-bar">

            <span class="status">
                ● Connected
            </span>

            <button
                type="button"
                class="save-btn"
                id="saveBtn"
            >
                Save
            </button>

        </div>

    </main>


    <!-- Socket.IO -->

    <script src="/socket.io/socket.io.js"></script>

    <!-- Monaco -->

    <script src="https://cdn.jsdelivr.net/npm/monaco-editor@0.52.2/min/vs/loader.js"></script>

    <script>

        require.config({
            paths: {
                vs: "https://cdn.jsdelivr.net/npm/monaco-editor@0.52.2/min/vs"
            }
        });


        require(
            ["vs/editor/editor.main"],
            function () {

                const editor = monaco.editor.create(
                    document.getElementById("editor"),
                    {
                        value: "",

                        language: "javascript",

                        theme: "vs-dark",

                        automaticLayout: true,

                        fontSize: 14,

                        tabSize: 4,

                        minimap: {
                            enabled: true
                        }
                    }
                );


                /*
                 * Socket.IO
                 */

                const socket = io();


                /*
                 * Prevent remote changes
                 * from being emitted again.
                 */

                let remotechange = false;

                let debounceTimer;


                /*
                 * Example file ID.
                 *
                 * If this page receives file data
                 * from EJS, replace this with:
                 *
                 * const fileId = "<%= file._id %>";
                 */

                const fileId =
                    "<%= typeof file !== 'undefined' ? file._id : '' %>";


                const username =
                    "<%= typeof user !== 'undefined' ? user.username : '' %>";


                /*
                 * Join file room
                 */

                if (fileId) {

                    socket.emit(
                        "join-file",
                        {
                            fileId: fileId,
                            username: username
                        }
                    );

                }


                /*
                 * Receive remote code
                 */

                socket.on(
                    "code-change",
                    (data) => {

                        remotechange = true;

                        editor.setValue(data.content);

                        remotechange = false;

                    }
                );


                /*
                 * Send code changes
                 */

                editor.onDidChangeModelContent(
                    () => {

                        if (remotechange) {
                            return;
                        }

                        clearTimeout(debounceTimer);

                        debounceTimer = setTimeout(
                            () => {

                                if (!fileId) {
                                    return;
                                }

                                socket.emit(
                                    "code-change",
                                    {
                                        fileId: fileId,
                                        content: editor.getValue()
                                    }
                                );

                            },
                            300
                        );

                    }
                );


                /*
                 * Active users
                 */

                socket.on(
                    "users-in-file",
                    (users) => {

                        const usersDiv =
                            document.getElementById("users");

                        usersDiv.innerHTML = "";

                        users.forEach(
                            (user) => {

                                usersDiv.innerHTML += `
                                    <span class="user">
                                        🟢 ${user.username}
                                    </span>
                                `;

                            }
                        );

                    }
                );


                /*
                 * Save button
                 *
                 * If you use your existing POST
                 * save route, connect it here.
                 */

                document
                    .getElementById("saveBtn")
                    .addEventListener(
                        "click",
                        () => {

                            console.log(
                                "Code to save:",
                                editor.getValue()
                            );

                        }
                    );

            }
        );

    </script>

</body>

</html>