<h1><%= project.name %></h1>
<h2>Files</h2>
<% files.forEach(file => { %>

    <div>
        <a href="/project/<%= project._id %>/file/<%= file._id %>">
            <%= file.name %>
        </a>
    </div>

<% }) %>

<form action="/project/<%= project._id %>/file" method="POST">

    <input
        type="text"
        name="name"
        placeholder="File name"
        required
    >

    <button type="submit">
        Create File
    </button>

</form>
<h2>Add Collaborator</h2>

<form action="/project/<%= project._id %>/collaborator" method="POST">

    <input 
        type="email"
        name="collaboratorEmail"
        placeholder="Collaborator email"
        required
    >

    <button type="submit">
        Add Collaborator
    </button>

</form>