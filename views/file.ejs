<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/file.css">
    <title>CodeCollab <%= file.name %>
    </title>
</head>

<body>

    <!-- Navbar -->

    <nav class="navbar">

        <div class="logo">
            CodeCollab
        </div>

        <div class="file-name">
            <%= file.name %>
        </div>

        <a href="/project/<%= project._id %>" class="back-btn">
            ← Back to Project
        </a>

    </nav>


    <!-- Main -->

    <main class="container">

        <div class="top-bar">

            <div class="title-section">

                <h1>
                    <%= file.name %>
                </h1>

                <p>
                    Collaborative code editor
                </p>

            </div>


            <div class="users">

                <span class="users-title">
                    Active users:
                </span>

                <div id="users"></div>

            </div>

        </div>




        <form action="/project/<%= project._id %>/file/<%= file._id %>" method="POST" id="saveForm">

            <div class="editor-container">

                <div id="editor"></div>

            </div>

            <input type="hidden" name="content" id="content">

            <div class="bottom-bar">

                <span class="status">
                    ● Connected
                </span>

                <button type="submit" class="save-btn">
                    Save File
                </button>

            </div>

        </form>

    </main>
    <script src="/js/RGA.js"></script>



    <script src="/socket.io/socket.io.js"></script>



    <script src="https://cdn.jsdelivr.net/npm/monaco-editor@0.52.2/min/vs/loader.js"></script>

    <script>

        require.config({
            paths: {
                vs: "https://cdn.jsdelivr.net/npm/monaco-editor@0.52.2/min/vs"
            }
        });

        require(
            ["vs/editor/editor.main"],
            function () {

                // MongoDB content
                const initialContent =
                <%- JSON.stringify(file.content || "") %>;

                // Create RGA
                const clientId = crypto.randomUUID();
                const rga = new RGA(clientId);

                // Load MongoDB content into RGA
                rga.loadText(initialContent);

                console.log("Initial RGA text:", rga.getText());
                console.log("RGA elements:", rga.elements);

                // Now initialize Monaco from RGA
                const editor = monaco.editor.create(
                    document.getElementById("editor"),
                    {
                        value: rga.getText(),

                        language: "javascript",

                        theme: "vs-dark",

                        automaticLayout: true,

                        minimap: {
                            enabled: true
                        },

                        fontSize: 14,

                        tabSize: 4
                    }
                );


                /* Save */

                document
                    .getElementById("saveForm")
                    .addEventListener(
                        "submit",
                        function () {

                            document
                                .getElementById("content")
                                .value = editor.getValue();

                        }
                    );


                /* Socket */

                const socket = io();

                const fileId = "<%= file._id %>";

                const username = "<%= user.username %>";

                let remotechange = false;

            
        








        /* Join file */
        console.log("Joining room:", fileId, username);
        socket.emit(
            "join-file",
            {
                fileId: fileId,
                username: username
            }
        );


        /* Receive code changes */

        socket.on(
            "crdt-operation",
            (operations) => {

                remotechange = true;
                console.log("Browser received:", operations);
                for (let operation of operations) {
                    rga.applyOperation(operation);
                }
                editor.setValue(rga.getText());
                remotechange = false;

            }
        );


        /* Send code changes */

        editor.onDidChangeModelContent(
            (event) => {

                if (remotechange) return;
                // first afterId
                const operations = [];
                for (const change of event.changes) {
                    const val = change.rangeLength;
                    if (val > 0) {
                        const ids = [];
                        for (let i = 0; i < val; i++) {
                            const id = rga.getElementAtPosition(change.rangeOffset + i); if (id !== null) {
                                ids.push(id);
                            }
                        } for (const id of ids) { const operation = rga.delete(id); operations.push(operation); }
                    }
                } for
                    (const change of event.changes) {
                        let afterId = rga.getElementBeforePosition(change.rangeOffset); const
                            val = change.text; if (val.length > 0) {
                                for (let i = 0; i < val.length; i++) {
                                    const operation = rga.insert(afterId, val[i]);
                                    operations.push(operation); afterId = operation.id;
                                }
                            }
                } if (operations.length > 0) {
                    console.log("Sending operations:", operations);
                    socket.emit("crdt-operations", {
                        fileId,
                        operations
                    });
                }

            }
        );

        /* Active users */

        socket.on(
            "users-in-file",
            (users) => {

                const usersDiv =
                    document.getElementById("users");

                usersDiv.innerHTML = "";

                users.forEach(
                    (user) => {

                        usersDiv.innerHTML += `
            <span class="user-badge">
                🟢 ${user.username}
            </span>
            `;

                    }
                );

            }
        );

        });


    </script>

</body>

</html>