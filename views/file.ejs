<h1>
    <%= file.name %>
</h1>
<form action="/project/<%= project._id %>/file/<%= file._id %>" method="POST" id="saveForm">

    <div id="editor" style="width: 100%; height: 500px;"></div>


    <input type="hidden" name="content" id="content">

    <button type="submit">Save</button>

</form>

<script src="/socket.io/socket.io.js"></script>
<script src="https://cdn.jsdelivr.net/npm/monaco-editor@0.52.2/min/vs/loader.js"></script>
<script>
    require.config({
        paths: {
            vs: "https://cdn.jsdelivr.net/npm/monaco-editor@0.52.2/min/vs"
        }
    });

    require(["vs/editor/editor.main"], function () {

        const editor = monaco.editor.create(
            document.getElementById("editor"),
            {
                value:  <%- JSON.stringify(file.content || "") %>,
                language: "javascript",
                theme: "vs-dark",
                automaticLayout: true
            }
        );
        document.getElementById("saveForm").addEventListener("submit", function () {

            document.getElementById("content").value = editor.getValue();

        });
        const socket = io();
        var remotechange=false;
        const fileId = "<%= file._id %>";
        socket.on("code-change", (data) => {
            remotechange=true;
            editor.setValue(data.content);
            remotechange=false;

        });
        editor.onDidChangeModelContent(() => {
            if(remotechange) return;
            const content = editor.getValue();
            console.log("Sending:", content);
            socket.emit("code-change", {
                fileId: fileId,
                content: content
            });

        });

        socket.emit("join-file", fileId);

    });

</script>