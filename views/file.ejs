<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>CodeCollab - <%= file.name %></title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            background: #0f172a;
            color: #e2e8f0;
            min-height: 100vh;
        }

        /* Navbar */

        .navbar {
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 0 25px;

            background: #111827;
            border-bottom: 1px solid #334155;
        }

        .logo {
            color: #60a5fa;
            font-size: 20px;
            font-weight: bold;
        }

        .file-name {
            color: #cbd5e1;
            font-size: 15px;
        }

        .back-btn {
            color: #94a3b8;
            text-decoration: none;
            font-size: 14px;
        }

        .back-btn:hover {
            color: white;
        }

        /* Main */

        .container {
            padding: 25px;
            max-width: 1400px;
            margin: auto;
        }

        /* Top section */

        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;

            margin-bottom: 15px;
        }

        .title-section h1 {
            font-size: 22px;
            margin-bottom: 5px;
        }

        .title-section p {
            color: #64748b;
            font-size: 13px;
        }

        /* Users */

        .users {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .users-title {
            color: #94a3b8;
            font-size: 13px;
        }

        #users {
            display: flex;
            gap: 6px;
        }

        .user-badge {
            background: #1e293b;
            border: 1px solid #334155;
            padding: 6px 10px;
            border-radius: 20px;
            font-size: 12px;
        }

        /* Editor */

        .editor-container {
            border: 1px solid #334155;
            border-radius: 10px;
            overflow: hidden;

            background: #1e1e1e;
        }

        #editor {
            width: 100%;
            height: 650px;
        }

        /* Bottom bar */

        .bottom-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;

            margin-top: 15px;
        }

        .status {
            color: #64748b;
            font-size: 13px;
        }

        .save-btn {
            padding: 10px 20px;

            background: #2563eb;
            color: white;

            border: none;
            border-radius: 7px;

            font-size: 14px;
            font-weight: 600;

            cursor: pointer;
        }

        .save-btn:hover {
            background: #1d4ed8;
        }

        @media (max-width: 700px) {

            .navbar {
                padding: 0 15px;
            }

            .container {
                padding: 15px;
            }

            .top-bar {
                flex-direction: column;
                align-items: flex-start;
                gap: 15px;
            }

            #editor {
                height: 500px;
            }

            .bottom-bar {
                flex-direction: column;
                align-items: flex-start;
                gap: 12px;
            }

            .save-btn {
                width: 100%;
            }
        }
    </style>
</head>

<body>

    <!-- Navbar -->

    <nav class="navbar">

        <div class="logo">
            CodeCollab
        </div>

        <div class="file-name">
            <%= file.name %>
        </div>

        <a
            href="/project/<%= project._id %>"
            class="back-btn"
        >
            ← Back to Project
        </a>

    </nav>


    <!-- Main -->

    <main class="container">

        <div class="top-bar">

            <div class="title-section">

                <h1>
                    <%= file.name %>
                </h1>

                <p>
                    Collaborative code editor
                </p>

            </div>


            <div class="users">

                <span class="users-title">
                    Active users:
                </span>

                <div id="users"></div>

            </div>

        </div>


        <!-- Editor -->

        <form
            action="/project/<%= project._id %>/file/<%= file._id %>"
            method="POST"
            id="saveForm"
        >

            <div class="editor-container">

                <div id="editor"></div>

            </div>

            <input
                type="hidden"
                name="content"
                id="content"
            >

            <div class="bottom-bar">

                <span class="status">
                    ● Connected
                </span>

                <button
                    type="submit"
                    class="save-btn"
                >
                    Save File
                </button>

            </div>

        </form>

    </main>


    <!-- Socket.IO -->

    <script src="/socket.io/socket.io.js"></script>

    <!-- Monaco -->

    <script src="https://cdn.jsdelivr.net/npm/monaco-editor@0.52.2/min/vs/loader.js"></script>

    <script>

        require.config({
            paths: {
                vs: "https://cdn.jsdelivr.net/npm/monaco-editor@0.52.2/min/vs"
            }
        });

        require(
            ["vs/editor/editor.main"],
            function () {

                const editor = monaco.editor.create(
                    document.getElementById("editor"),
                    {
                        value: <%- JSON.stringify(file.content || "") %>,

                        language: "javascript",

                        theme: "vs-dark",

                        automaticLayout: true,

                        minimap: {
                            enabled: true
                        },

                        fontSize: 14,

                        tabSize: 4
                    }
                );


                /* Save */

                document
                    .getElementById("saveForm")
                    .addEventListener(
                        "submit",
                        function () {

                            document
                                .getElementById("content")
                                .value = editor.getValue();

                        }
                    );


                /* Socket */

                const socket = io();

                const fileId = "<%= file._id %>";

                const username = "<%= user.username %>";

                let remotechange = false;

                let debounceTimer;


                /* Join file */

                socket.emit(
                    "join-file",
                    {
                        fileId: fileId,
                        username: username
                    }
                );


                /* Receive code changes */

                socket.on(
                    "code-change",
                    (data) => {

                        remotechange = true;

                        editor.setValue(data.content);

                        remotechange = false;

                    }
                );


                /* Send code changes */

                editor.onDidChangeModelContent(
                    () => {

                        if (remotechange) {
                            return;
                        }

                        clearTimeout(debounceTimer);

                        debounceTimer = setTimeout(
                            () => {

                                const content =
                                    editor.getValue();

                                socket.emit(
                                    "code-change",
                                    {
                                        fileId: fileId,
                                        content: content
                                    }
                                );

                            },
                            300
                        );

                    }
                );


                /* Active users */

                socket.on(
                    "users-in-file",
                    (users) => {

                        const usersDiv =
                            document.getElementById("users");

                        usersDiv.innerHTML = "";

                        users.forEach(
                            (user) => {

                                usersDiv.innerHTML += `
                                    <span class="user-badge">
                                        🟢 ${user.username}
                                    </span>
                                `;

                            }
                        );

                    }
                );

            }
        );

    </script>

</body>

</html>